# Crypgo Environment Configuration Template
# Copy this file to .env and fill in your values

# ==========================================
# Frontend (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=/backend-api
CRYPGO_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://localhost:5001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:5000
# Set to "/Crypgo" when deploying to GitHub Pages project path (e.g., username.github.io/Crypgo)
# Leave empty or unset for root deployments (local, Cloudflare Tunnel, Vercel, etc.)
NEXT_PUBLIC_BASE_PATH=

# ==========================================
# Crypgo Django Backend (Port 8000)
# ==========================================
SECRET_KEY=your-django-secret-key-here
DEBUG=True
FRONTEND_URL=http://localhost:5000

# Database
DB_NAME=crypgo_db
DB_USER=crypgo_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP)
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Bot Service Integration
BOT_SERVICE_URL=http://localhost:8001
BOT_SERVICE_KEY=your-shared-service-key

# CoinGecko plan: demo by default; use pro only for a paid Pro key.
COINGECKO_API_PLAN=demo
# Set COINGECKO_API_KEY in Vercel, or use COINGECKO_API_KEYS locally for key rotation.
# When both are set, COINGECKO_API_KEYS takes precedence.
COINGECKO_API_KEY=your-coingecko-api-key
COINGECKO_API_KEYS=your-coingecko-api-key-1,your-coingecko-api-key-2

# ==========================================
# Bot Django Backend (Port 8001)
# ==========================================
DJANGO_SECRET_KEY=your-bot-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Email bot (ZeptoMail SMTP)
MAIL_PROVIDER=zeptomail
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_SMTP_USE_TLS=True
ZEPTOMAIL_SMTP_USE_SSL=False
ZEPTOMAIL_SMTP_USERNAME=emailapikey
ZEPTOMAIL_SMTP_PASSWORD=
ZEPTOMAIL_FROM_ADDRESS=info@crypgo.us.ci
EMAIL_FROM_NAME=Crypgo

# Gmail SMTP remains available by setting MAIL_PROVIDER=gmail and configuring
# both accounts below. Never commit real passwords or app passwords.
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
# GMAIL_SMTP_USE_TLS=True
# GMAIL_SMTP_USE_SSL=False
# GMAIL_SMTP_PRIMARY_EMAIL=support.crypgo@gmail.com
# GMAIL_SMTP_PRIMARY_PASSWORD=
# GMAIL_SMTP_SECONDARY_EMAIL=news.crypgo@gmail.com
# GMAIL_SMTP_SECONDARY_PASSWORD=

# Site URL
SITE_URL=http://localhost:8001

# Crypgo Integration
CRYPGO_API_URL=http://localhost:8000
CRYPGO_SERVICE_KEY=your-shared-service-key

# ==========================================
# Other Services
# ==========================================
# WebSocket Server Port
WS_PORT=5001